# Docker Compose quick start:
#   cp .env.example .env
#   docker compose up -d --build
#
# Compose reads this file for ${VAR} substitution and passes it to cellpd via env_file.
# Only override what you need; defaults target single-node embedded-agent deploy.

# --- Published ports ---
GATEWAY_PORT=8787
PLATFORM_PORT=8790
S3_PORT=19000
S3_CONSOLE_PORT=19001

# --- Auth (change in production) ---
CELLP_DEPLOY_TOKEN=dev-local-token
CELLP_ADMIN_TOKEN=dev-local-token

# --- RustFS / S3 ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
AWS_REGION=us-east-1

# --- cellp storage paths (inside container) ---
CELLD_BUCKET=s3://cellp-celld/demo-app
CELLP_ARTIFACTS_BUCKET=cellp-artifacts
OFFSHOOT_STORE=s3://cellp-offshoot
CELLD_PORT=8792

# --- Public URLs (what browsers / CI use to reach the host) ---
GATEWAY_URL=http://127.0.0.1:8787
PLATFORM_URL=http://127.0.0.1:8790

# --- GHCR image (optional; omit to build locally) ---
# CELLP_IMAGE=ghcr.io/konghayo/cellp:latest

# --- Elastic embedded Node Agent (AD-15; required by cellpd) ---
# CELLP_ELASTIC_RUNTIME unset = on. Set to off/0/false/no to reject startup.
CELLP_AGENT_EMBEDDED=1
CELLP_AGENT_NODE_ID=docker-node
CELLP_AGENT_BIND_ADDR=127.0.0.1:19443
CELLP_AGENT_ADVERTISE_URL=https://127.0.0.1:19443
CELLP_AGENT_ALLOW_PRIVATE_NAT=false
CELLP_AGENT_NODE_IDENTITY_URI=spiffe://cellp/local/node/docker-node
CELLP_AGENT_CONTROLLER_IDENTITY_URI=spiffe://cellp/local/controller/main
CELLP_AGENT_ALLOWED_CONTROLLER_URIS=spiffe://cellp/local/controller/main
CELLP_AGENT_SERVER_CERT_FILE=/data/certs/elastic/agent-server.pem
CELLP_AGENT_SERVER_KEY_FILE=/data/certs/elastic/agent-server-key.pem
CELLP_AGENT_SERVER_CA_FILE=/data/certs/elastic/ca.pem
CELLP_AGENT_CLIENT_CERT_FILE=/data/certs/elastic/agent-client.pem
CELLP_AGENT_CLIENT_KEY_FILE=/data/certs/elastic/agent-client-key.pem
CELLP_AGENT_CLIENT_CA_FILE=/data/certs/elastic/ca.pem
CELLP_AGENT_TLS_SERVER_NAME=127.0.0.1
CELLP_AGENT_CERT_DENYLIST_FILE=/data/certs/elastic/denylist.pem
CELLP_AGENT_CAPACITY_UNITS=8
CELLP_AGENT_ZONE=docker
CELLP_AGENT_HEARTBEAT_TTL=30s
CELLP_AGENT_HEARTBEAT_INTERVAL=10s
CELLP_AGENT_RECONCILE_INTERVAL=5s
CELLP_AGENT_MAX_BODY_BYTES=1048576
CELLP_AGENT_REPLAY_MAX_ENTRIES=4096

# Optional: override auto-generated cert directory (volume mount at /data/certs/elastic)
# CELLP_ELASTIC_CERT_DIR=/data/certs/elastic
