# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- dependencies (any package root) ---
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- frontend build (Vite SPA) ---
**/.next/
**/dist/
/out/
/build

# --- Playwright / test output ---
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# --- testing coverage ---
/coverage
**/coverage.out

# --- misc ---
.DS_Store
*.pem
next-env.d.ts
tsconfig.tsbuildinfo

# --- debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- env (never commit secrets) ---
.env*
!.env.example
!**/.env.example
!dev/.env.example

# --- local dev runtime state ---
/dev/data/
/dev/.env

# --- cellp build artifacts ---
cellp/cellpd
cellp/cellp
cellp/cellpd.exe
cellp/cellp.exe
dev/bin/
*.exe

# --- SQLite registry (runtime) ---
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- research clones / agent scratch ---
/offshoot-research/
/agent-tools/
**/.ux-review*/
**/.ux-review-r*/

# --- support community clones (deploy-support-app) ---
/dev/support-corpus/

# --- test / stress / support runtime evidence (local only) ---
docs/evidence/
!docs/evidence/.gitkeep

# --- local agent / IDE (workflows & run logs, not product source) ---
.claude/
.peri/
peri/
.wrangler/

# --- vercel ---
.vercel

# --- VitePress (public docs site) ---
site/**/.vitepress/cache
site/**/.vitepress/dist
