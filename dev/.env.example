# Cell Platform — local dev (copy to dev/.env)
# 私有化同构：对象存储统一 RustFS，不依赖外部云

PLATFORM_TOKEN=dev-local-token
PLATFORM_URL=http://127.0.0.1:8790
GATEWAY_URL=http://127.0.0.1:8787

# AD-12 ingress — see dev/INGRESS-HOST.md
# ./dev/scripts/ingress-host-init.sh
CELLP_INGRESS_BASE_DOMAIN=lvh.me
CELLP_PUBLIC_SCHEME_PREVIEW=http
CELLP_PUBLIC_SCHEME_PROD=http
INGRESS_HOST_ONLY=1

# support / 框架部署包管理器源（deploy-support-app.sh 默认 npmmirror；安装用 pnpm）
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Optional dev HTTPS
# GATEWAY_TLS_PORT=8788
# GATEWAY_TLS_CERT=./dev/data/certs/gateway.pem
# GATEWAY_TLS_KEY=./dev/data/certs/gateway-key.pem
# CELLP_TLS_EXTRA_SAN=support-flaremo.lvh.me

# Agent demos (A02 pi-worker, A05 Mastra) — OpenCode Zen 公共 OpenAI 兼容端点（与 wrangler.cellp 默认一致）
# OPENAI_API_KEY=public
# OPENAI_BASE_URL=https://opencode.ai/zen/v1
# OPENAI_MODEL=big-pickle

# fx-on-workers (A04) — Vercel AI Gateway (do not commit real keys)
# AI_GATEWAY_API_KEY=
# FX_MODEL=minimax/minimax-m3-free

# Gateway / internal services
GATEWAY_PORT=8787
PLATFORM_PORT=8790
CELLD_PORT=8792
OFFSHOOT_HTTP_PORT=8793

# RustFS (unified object store — celld + offshoot + artifacts)
S3_PORT=19000
S3_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_ENDPOINT=http://127.0.0.1:19000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1

CELLD_BUCKET=s3://cellp-celld/commerce-store

# offshoot — prod uses RustFS; dev defaults to local dir for quick start
OFFSHOOT_STORE=./dev/data/offshoot-store
# OFFSHOOT_STORE=s3://cellp-offshoot
# OFFSHOOT_S3_ENDPOINT=http://127.0.0.1:19000
# OFFSHOOT_S3_PATH_STYLE=1
OFFSHOOT_CHECKOUTS=./dev/data/offshoot-checkouts
OFFSHOOT_HTTP_TOKEN=dev-offshoot-token

# Paths
DEV_DATA_DIR=./dev/data
ARTIFACTS_DIR=./dev/data/artifacts
# Shared dev celld on :8792 only. Per-version celld uses ephemeral $TMPDIR watch (see AD-1).
CELLD_WATCH=./dev/data/celld-watch
# CELLP_CELLD_WATCH_PERSIST=1  # debug: persist per-version watch under dev/data/celld-watch
REGISTRY_DB=./dev/data/cellp-registry.sqlite

# cellpd tokens / registry
CELLP_REGISTRY_DB=./dev/data/cellp-registry.sqlite
CELLP_DEPLOY_TOKEN=dev-local-token
CELLP_ADMIN_TOKEN=dev-local-token

# Deploy orchestrator: default fail-closed (offshoot/D1/binding branch errors abort deploy).
# CELLP_LENIENT_DEPLOY=1  # local debug only: warn and continue toward ready (not for CI/e2e)

# Elastic Node Agent (cellpd always uses AD-15 elastic control plane; unset CELLP_ELASTIC_RUNTIME defaults on).
# Explicit off (0/false/no/off) makes cellp serve and cellp agent exit at startup.
# Certificate/key/CA files must be provisioned out-of-band; never paste PEM or secrets here.
#
# cellp serve (cellpd): CELLP_AGENT_EMBEDDED defaults to 1 (embedded Node Agent in the serve process).
# Controller-only (no embedded agent): CELLP_AGENT_EMBEDDED=0 and full CELLP_CONTROLLER_REMOTE_* below.
# Outbound scheduler mTLS (serve → remote agents) uses CELLP_AGENT_CLIENT_* + CELLP_AGENT_CONTROLLER_IDENTITY_URI.
# Standalone cellp agent uses CELLP_AGENT_* node/bind/TLS fields plus remote controller URLs (not read by serve when embedded=0).
#
# CELLP_AGENT_EMBEDDED=1
# --- embedded / standalone agent node fields (cellp agent; optional on serve when embedded=1) ---
# CELLP_AGENT_NODE_ID=
# CELLP_AGENT_BIND_ADDR=
# CELLP_AGENT_ADVERTISE_URL=
# CELLP_AGENT_ALLOW_PRIVATE_NAT=false
# CELLP_AGENT_NODE_IDENTITY_URI=
# CELLP_AGENT_CONTROLLER_IDENTITY_URI=
# CELLP_AGENT_ALLOWED_CONTROLLER_URIS=
# CELLP_AGENT_SERVER_CERT_FILE=
# CELLP_AGENT_SERVER_KEY_FILE=
# CELLP_AGENT_SERVER_CA_FILE=
# CELLP_AGENT_CLIENT_CERT_FILE=
# CELLP_AGENT_CLIENT_KEY_FILE=
# CELLP_AGENT_CLIENT_CA_FILE=
# CELLP_AGENT_TLS_SERVER_NAME=
# CELLP_AGENT_CERT_DENYLIST_FILE=
# CELLP_AGENT_CAPACITY_UNITS=
# CELLP_AGENT_ZONE=
# CELLP_AGENT_HEARTBEAT_TTL=
# CELLP_AGENT_HEARTBEAT_INTERVAL=
# CELLP_AGENT_RECONCILE_INTERVAL=
# CELLP_AGENT_MAX_BODY_BYTES=
# CELLP_AGENT_REPLAY_MAX_ENTRIES=
# --- standalone cellp agent only (remote controller HTTPS); do not set on controller-only serve ---
# CELLP_AGENT_NODEREG_BASE_URL=https://127.0.0.1:19450
# CELLP_AGENT_REGISTRY_RELAY_BASE_URL=https://127.0.0.1:19450
# CELLP_AGENT_CONTROLLER_TLS_SERVER_NAME=127.0.0.1
# CELLP_AGENT_RELAY_SCOPE_TTL=90s
#
# --- controller remote control (serve, when CELLP_AGENT_EMBEDDED=0) ---
# CELLP_CONTROLLER_IDENTITY_URI=spiffe://cellp/local/controller/main
# CELLP_CONTROLLER_REMOTE_BIND_ADDR=127.0.0.1:19445
# CELLP_CONTROLLER_REMOTE_SERVER_CERT_FILE=/path/to/controller-server.pem
# CELLP_CONTROLLER_REMOTE_SERVER_KEY_FILE=/path/to/controller-server-key.pem
# CELLP_CONTROLLER_REMOTE_SERVER_CA_FILE=/path/to/controller-ca.pem
# CELLP_CONTROLLER_REMOTE_CERT_DENYLIST_FILE=/path/to/denylist.pem
# CELLP_CONTROLLER_NODE_ALLOWLIST_FILE=/path/to/node-allowlist.json
# CELLP_CONTROLLER_REMOTE_NODE_HEARTBEAT_TTL=30s
# CELLP_CONTROLLER_REMOTE_MAX_BODY_BYTES=1048576
# CELLP_CONTROLLER_REMOTE_REPLAY_MAX_ENTRIES=4096
# node allowlist JSON (no secrets), e.g. [{"node_id":"n1","identity_uri":"spiffe://cellp/zone/node/n1","agent_base_url":"https://127.0.0.1:19444","allow_loopback":true}]

# Elastic serving defaults (serverless-aligned; per-version overrides via serving policy API later)
# Default cold: min=0, idle after deploy → desired=0 until traffic (activator bumps desire).
# CELLP_SERVING_DEFAULT_MIN_REPLICAS=0
# CELLP_SERVING_MAX_REPLICAS=8
# CELLP_SERVING_IDLE_AFTER_DEPLOY=1
# CELLP_SERVING_SCALE_TO_ZERO=1
# CELLP_SERVING_PROD_SCALE_TO_ZERO=0
# CELLP_SERVING_DEFAULT_BACKGROUND=none

DASHBOARD_PORT=5190

# Example project
DEV_PROJECT=commerce-store
DEV_EXAMPLE=./dev/examples/commerce
COMMERCE_PROJECT=commerce-store
COMMERCE_VERSION=v1
