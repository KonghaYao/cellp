{
  "name": "support-astro",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".cellp-assets",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000-0000-0000-0000-000000000002"
    }
  ]
}
