{
  "name": "support-r2explorer",
  "main": "template/src/index.ts",
  "compatibility_date": "2024-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "template/node_modules/r2-explorer/dashboard",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/share/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "support-r2explorer-bucket"
    }
  ]
}
