{
  "name": "support-status-page",
  "main": "dist/main.js",
  "compatibility_date": "2021-07-23",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "KV_STATUS_PAGE",
      "id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
