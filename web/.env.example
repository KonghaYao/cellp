VITE_CELLP_API_URL=
VITE_CELLP_ADMIN_TOKEN=dev-local-token
VITE_CELLP_DEPLOY_TOKEN=
VITE_CELLP_GATEWAY_URL=
# Dev: leave API/Gateway URLs empty — Vite proxies /v1 and /__gateway to cellpd (:8790) and gateway (:8787).
# Production build: set full URLs, e.g. VITE_CELLP_API_URL=http://127.0.0.1:8790
DASHBOARD_PORT=5190
