VITE_CELLP_API_URL=
VITE_CELLP_ADMIN_TOKEN=dev-local-token
VITE_CELLP_DEPLOY_TOKEN=
VITE_CELLP_GATEWAY_URL=
# AD-12: ingress host suffix (must match cellpd CELLP_INGRESS_BASE_DOMAIN)
VITE_CELLP_INGRESS_BASE_DOMAIN=ingress.local
# Dev/LAN: include port so UI shows http://host:8787/ (default http://127.0.0.1:8787)
# VITE_CELLP_GATEWAY_URL=http://192.168.1.10:8787
# Production build: set full URLs, e.g. VITE_CELLP_API_URL=http://127.0.0.1:8790
DASHBOARD_PORT=5190
